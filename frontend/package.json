{
	"name": "subsd-frontend",
	"version": "0.5.2",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"scripts": {
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write ./src/**/*.{ts,tsx,css}",
		"format:check": "prettier --check ./src/**/*.{ts,tsx,css}",
		"lint": "eslint \"./src/**/*.{tsx,ts}\"",
		"lint:errors": "eslint --quiet \"./src/**/*.{tsx,ts}\"",
		"lint:fix": "eslint --fix \"./src/**/*.{tsx,ts}\"",
		"lint:style": "stylelint \"./src/**/*.css\"",
		"lint:style:fix": "stylelint \"./src/**/*.css\" --fix",
		"checkstyle": "pnpm run checkstyle:ts && pnpm run checkstyle:style && pnpm run checkstyle:format && pnpm run checkstyle:i18n",
		"checkstyle:format": "pnpm run format:check",
		"checkstyle:ts": "eslint \"./src/**/*.{ts,tsx}\" -f checkstyle > ci/eslint.xml",
		"checkstyle:style": "stylelint \"./src/**/*.css\" --custom-formatter stylelint-checkstyle-formatter -o ci/stylelint.xml",
		"checkstyle:i18n": "sync-i18n --check --files '**/locales/*.json' --primary en --languages en --space 2 --lineendings LF",
		"i18n-sync": "sync-i18n --files '**/locales/*.json' --primary en --languages en --space 2 --lineendings LF",
		"clean": "npx --quiet rimraf ../web/dist && npx --quiet rimraf ci/*.xml && npx --quiet rimraf node_modules"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/syne": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"clsx": "2.1.1",
		"i18next": "26.4.2",
		"lucide-react": "1.47.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "17.0.15",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-checkstyle": "9.0.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-sonarjs": "4.2.1",
		"eslint-plugin-testing-library": "7.16.2",
		"i18next-json-sync": "3.1.2",
		"jsdom": "30.1.0",
		"prettier": "3.9.8",
		"rimraf": "6.1.3",
		"shadcn": "4.21.0",
		"stylelint": "17.15.0",
		"stylelint-checkstyle-formatter": "0.1.2",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-block-no-ignored-properties": "3.0.0",
		"stylelint-order": "8.1.1",
		"stylelint-prettier": "5.0.3",
		"typescript": "6.0.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
